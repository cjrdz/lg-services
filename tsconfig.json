{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", ".wrangler"],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		},
		"types": ["astro/client", "node"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"strictNullChecks": true,
		"verbatimModuleSyntax": true
	}
}
