# Copiar a .env y llenar. NUNCA commitear .env.
#
# En producción estos NO van en .env: se cargan como secretos del Worker con
#   bunx wrangler secret put NOMBRE

# --- Keystatic en modo GitHub ---
# Se generan solos la primera vez que entrás a /keystatic y conectás el repo.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# 64 caracteres aleatorios:  openssl rand -hex 32
KEYSTATIC_SECRET=
# El "slug" de la GitHub App creada en ese paso.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- R2 (solo para scripts locales: siembra masiva y media-gc) ---
# La app en runtime NO usa esto: usa el binding MEDIA de wrangler.jsonc.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lg-services-media
# La URL pub-<hash>.r2.dev que da Cloudflare, o el dominio propio cuando exista.
R2_PUBLIC_BASE_URL=

# --- Formulario de contacto ---
# Sin esto el formulario responde 503 y la interfaz manda a WhatsApp.
RESEND_API_KEY=

# --- Anti-spam (opcional) ---
# Sin la clave pública el widget ni se dibuja; queda solo el honeypot.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
