---
import { localePaths, localizedUrl } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { getServicios } from "@/lib/contenido";
import { AREAS } from "@/lib/taxonomia";
import { esquemaMigas, migasDe } from "@/lib/seo";

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://gutierrezgroup.blog");

const servicios = await getServicios(locale);
const migas = migasDe(locale, [{ nombre: t("servicios.titulo") }]);

const listado = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: t("servicios.titulo"),
	numberOfItems: servicios.length,
	itemListElement: servicios.map((s, i) => ({
		"@type": "ListItem",
		position: i + 1,
		name: s.data.titulo,
		url: new URL(localizedUrl(`/servicios/${s.data.area}`, locale), site).href,
	})),
};
---

<BaseLayout
	locale={locale}
	titulo={t("servicios.titulo")}
	descripcion={t("servicios.descripcion")}
	esquemas={[esquemaMigas(migas, site), listado]}
>
	<section class="contenedor py-16 lg:py-20">
		<h1 class="font-serif text-4xl font-normal tracking-tight sm:text-5xl">
			{t("servicios.titulo")}
		</h1>
		<p class="text-muted-foreground mt-4 max-w-[58ch] text-lg leading-relaxed">
			{t("servicios.descripcion")}
		</p>

		{
			/*
		  This is where the area badges live now.

		  The home grid dropped its icons — seven lucide glyphs of the same
		  weight distinguish nothing. But `area-icono-<área>` is a view
		  transition and a transition needs a source, so this index becomes the
		  origin of that chain: badge here → big badge on the área page.
		*/
		}
		<div class="rejilla-hilo aparece-escalonado mt-10 sm:grid-cols-2 lg:grid-cols-3">
			{
				servicios.map((s) => (
					<a
						href={localizedUrl(`/servicios/${s.data.area}`, locale)}
						class="bg-card hover:bg-secondary group elevable relative flex flex-col p-7"
					>
						<span
							transition:name={`area-icono-${s.data.area}`}
							class="bg-secondary text-secondary-foreground group-hover:bg-primary group-hover:text-primary-foreground color-animado mb-4 inline-flex size-11 items-center justify-center rounded-sm"
						>
							<Icon name={AREAS[s.data.area].icono} size={22} />
						</span>
						<h2 class="text-primary font-serif text-[1.35rem] leading-tight font-medium">
							{s.data.titulo}
						</h2>
						<p class="text-muted-foreground mt-2 text-[0.95rem] leading-relaxed">
							{s.data.resumen}
						</p>
						<Icon
							name="lucide:arrow-right"
							size={16}
							class="text-primary flecha-tarjeta absolute right-6 bottom-6"
						/>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
