---
import { localePaths, localizedUrl } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { getServicios } from "@/lib/contenido";
import { AREAS } from "@/lib/taxonomia";
import { esquemaMigas, migasDe } from "@/lib/seo";

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://lisbethgutierrez.com");

const servicios = await getServicios(locale);
const migas = migasDe(locale, [{ nombre: t("servicios.titulo") }]);

const listado = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: t("servicios.titulo"),
	numberOfItems: servicios.length,
	itemListElement: servicios.map((s, i) => ({
		"@type": "ListItem",
		position: i + 1,
		name: s.data.titulo,
		url: new URL(localizedUrl(`/servicios/${s.data.area}`, locale), site).href,
	})),
};
---

<BaseLayout
	locale={locale}
	titulo={t("servicios.titulo")}
	descripcion={t("servicios.descripcion")}
	esquemas={[esquemaMigas(migas, site), listado]}
>
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<h1 class="font-serif text-4xl font-bold tracking-tight">
			{t("servicios.titulo")}
		</h1>
		<p class="text-muted-foreground mt-3 max-w-2xl text-lg">
			{t("servicios.descripcion")}
		</p>

		<div
			class="aparece aparece-escalonado mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
		>
			{
				servicios.map((s) => (
					<a
						href={localizedUrl(`/servicios/${s.data.area}`, locale)}
						class="border-border bg-card hover:border-primary/40 group elevable rounded-xl border p-6"
					>
						<span class="bg-secondary text-secondary-foreground mb-4 inline-flex size-11 items-center justify-center rounded-xl">
							<Icon name={AREAS[s.data.area].icono} size={22} />
						</span>
						<h2 class="group-hover:text-primary font-semibold transition-colors">
							{s.data.titulo}
						</h2>
						<p class="text-muted-foreground mt-2 text-sm">{s.data.resumen}</p>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
