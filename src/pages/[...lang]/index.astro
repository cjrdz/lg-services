---
import { localePaths } from "@/i18n/routing";
import { localizedUrl } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ImagenLocal from "@/components/ImagenLocal.astro";
import Hero from "@/components/Hero.astro";
import * as Card from "@/components/ui/card";
import { INICIO, SITIO } from "@/lib/sitio";
import { areasOrdenadas } from "@/lib/taxonomia";
import { esquemaNegocio, esquemaSitioWeb } from "@/lib/seo";
import { getTarjetasPropiedades, getTarjetasVehiculos } from "@/lib/anuncios";
import Destacados from "@/components/anuncios/Destacados.svelte";
import AnimarAlScroll from "@/components/AnimarAlScroll.svelte";

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://lisbethgutierrez.com");

const areas = areasOrdenadas(locale);

const destacadas: import("@/lib/anuncios-tipos").TarjetaAnuncio[] = [];
if (INICIO.mostrarPropiedadesDestacadas) {
	const propiedades = (await getTarjetasPropiedades(locale)).filter(
		(p) => p.destacado,
	);
	destacadas.push(...propiedades.slice(0, INICIO.maxDestacados));
}
if (INICIO.mostrarVehiculosDestacados) {
	const vehiculos = (await getTarjetasVehiculos(locale)).filter(
		(v) => v.destacado,
	);
	destacadas.push(...vehiculos.slice(0, INICIO.maxDestacados));
}
// Sort by explicit order, then keep a stable mix.
const destacados = destacadas
	.sort((a, b) => (a.orden ?? 0) - (b.orden ?? 0))
	.slice(0, INICIO.maxDestacados);
---

<BaseLayout
	locale={locale}
	titulo={SITIO.nombre}
	descripcion={t("sitio.descripcion")}
	tituloExacto
	esquemas={[esquemaNegocio(site), esquemaSitioWeb(site)]}
>
	<Hero
		titulo={INICIO.heroTitulo}
		subtitulo={INICIO.heroSubtitulo}
		ctaTexto={INICIO.heroCtaTexto}
		ctaUrl={localizedUrl(INICIO.heroCtaUrl, locale)}
		ctaSecundarioTexto={t("home.heroCtaSecundario")}
		ctaSecundarioUrl={localizedUrl("/servicios", locale)}
	>
		<ImagenLocal
			slot="imagen"
			src={INICIO.heroImagen}
			alt={INICIO.heroImagenAlt}
			contexto="heroImagen de src/data/inicio/index.json"
			ratio="3 / 4"
			sizes="(min-width: 1024px) 28rem, (min-width: 640px) 24rem, 90vw"
			loading="eager"
			fetchpriority="high"
			class="object-top"
		/>
	</Hero>

	{
		INICIO.propuestas.length > 0 && (
			<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
				<AnimarAlScroll selector=".scroll-animable" stagger={0.1} client:load>
					<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{INICIO.propuestas.map((p) => (
							<Card.Root class="scroll-animable">
								<Card.Header>
									<span class="bg-secondary text-secondary-foreground mb-2 inline-flex size-11 items-center justify-center rounded-xl">
										<Icon name={p.icono} size={22} />
									</span>
									<Card.Title>{p.titulo}</Card.Title>
									<Card.Description>{p.descripcion}</Card.Description>
								</Card.Header>
							</Card.Root>
						))}
					</div>
				</AnimarAlScroll>
			</section>
		)
	}

	<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
		<AnimarAlScroll selector=".scroll-animable" stagger={0.05} start="top 82%" client:load>
			<div class="scroll-animable mb-8">
				<h2 class="font-serif text-3xl font-bold tracking-tight">
					{t("home.seccionServicios")}
				</h2>
				<p class="text-muted-foreground mt-2">{t("home.seccionServiciosTexto")}</p>
			</div>

			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					areas.map((area) => (
						<a
							href={localizedUrl(`/servicios/${area.id}`, locale)}
							class="scroll-animable border-border bg-card hover:border-primary/40 group elevable rounded-xl border p-5"
						>
							<span class="bg-secondary text-secondary-foreground mb-3 inline-flex size-10 items-center justify-center rounded-lg">
								<Icon name={area.icono} size={20} />
							</span>
							<h3 class="group-hover:text-primary font-semibold transition-colors">
								{area.titulo}
							</h3>
							<p class="text-muted-foreground mt-1 text-sm">{area.resumen}</p>
						</a>
					))
				}
			</div>
		</AnimarAlScroll>
	</section>

	{
		destacados.length > 0 && (
			<Destacados
				tarjetas={destacados}
				textos={{
					titulo: t("home.destacados.titulo"),
					descripcion: t("home.destacados.descripcion"),
					verPropiedades: localizedUrl("/propiedades", locale),
					verVehiculos: localizedUrl("/vehiculos", locale),
					etiquetaPropiedades: t("home.destacados.verPropiedades"),
					etiquetaVehiculos: t("home.destacados.verVehiculos"),
					sinFoto: t("common.sinFoto"),
					consultarPrecio: t("propiedades.consultarPrecio"),
				}}
				client:load
			/>
		)
	}
</BaseLayout>
