---
import { localePaths, localizedUrl } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ImagenLocal from "@/components/ImagenLocal.astro";
import Hero from "@/components/inicio/Hero.astro";
import AreasPractica from "@/components/inicio/AreasPractica.astro";
import Proceso from "@/components/inicio/Proceso.astro";
import SobreMi from "@/components/inicio/SobreMi.astro";
import Modulos from "@/components/inicio/Modulos.astro";
import CierreContacto from "@/components/inicio/CierreContacto.astro";
import { INICIO, whatsappUrl } from "@/lib/sitio";
import { esquemaNegocio, esquemaSitioWeb } from "@/lib/seo";
import { getTarjetasPropiedades, getTarjetasVehiculos } from "@/lib/anuncios";

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://gutierrezgroup.blog");

const destacadas: import("@/lib/anuncios-tipos").TarjetaAnuncio[] = [];
if (INICIO.mostrarPropiedadesDestacadas) {
	const propiedades = (await getTarjetasPropiedades(locale)).filter((p) => p.destacado);
	destacadas.push(...propiedades.slice(0, INICIO.maxDestacados));
}
if (INICIO.mostrarVehiculosDestacados) {
	const vehiculos = (await getTarjetasVehiculos(locale)).filter((v) => v.destacado);
	destacadas.push(...vehiculos.slice(0, INICIO.maxDestacados));
}
// Sort by explicit order, then keep a stable mix.
const destacados = destacadas
	.sort((a, b) => (a.orden ?? 0) - (b.orden ?? 0))
	.slice(0, INICIO.maxDestacados);
---

{
	/*
	  The home reads as one document: full-bleed bands stacked and separated by
	  a hairline, all of them aligned on the same measure via `.contenedor`.

	  Order is an argument. Who she is and what she does → what she handles →
	  how a case actually runs → who's behind it → the secondary verticals →
	  how to reach her. The patrimonial modules come after the practice because
	  they ARE secondary to it.
	*/
}
<BaseLayout
	locale={locale}
	titulo={t("nav.inicio")}
	descripcion={t("sitio.descripcion")}
	esquemas={[esquemaNegocio(site), esquemaSitioWeb(site)]}
>
	<Hero
		etiqueta={INICIO.heroEtiqueta}
		titulo={INICIO.heroTitulo}
		subtitulo={INICIO.heroSubtitulo}
		ctaTexto={INICIO.heroCtaTexto}
		ctaUrl={localizedUrl(INICIO.heroCtaUrl, locale)}
		ctaSecundarioTexto={t("common.whatsapp")}
		ctaSecundarioUrl={whatsappUrl()}
		datos={INICIO.heroDatos}
	>
		<ImagenLocal
			slot="imagen"
			src={INICIO.heroImagen}
			alt={INICIO.heroImagenAlt}
			contexto="heroImagen de src/data/inicio/index.json"
			sizes="(min-width: 1024px) 34rem, 100vw"
			loading="eager"
			fetchpriority="high"
			class="retrato-neutro absolute inset-0 size-full object-cover object-[50%_18%]"
		/>
	</Hero>

	<AreasPractica locale={locale} />

	<Proceso locale={locale} intro={INICIO.procesoIntro} pasos={INICIO.procesoPasos} />

	<SobreMi
		locale={locale}
		cita={INICIO.sobreMiCita}
		texto={INICIO.sobreMiTexto}
		imagen={INICIO.sobreMiImagen}
	/>

	<Modulos locale={locale} destacados={destacados} />

	<CierreContacto locale={locale} />
</BaseLayout>
