---
import { localePathsFor, localizedUrl } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import { etiqueta } from "@/i18n/enums";
import BaseLayout from "@/layouts/BaseLayout.astro";
import R2Image from "@/components/media/R2Image.astro";
import Icon from "@/components/Icon.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { getPropiedades } from "@/lib/anuncios";
import { ubicacionTexto } from "@/lib/geo/el-salvador";
import { formatearPrecio } from "@/lib/formato";
import { esquemaMigas, migasDe } from "@/lib/seo";
import { whatsappUrl } from "@/lib/sitio";

export async function getStaticPaths() {
	const propiedades = await getPropiedades();
	return localePathsFor(
		propiedades.map((p) => ({ params: { slug: p.id }, props: { propiedad: p } })),
	);
}

const { propiedad, locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://lisbethgutierrez.com");

const d = propiedad.data;
const portada = d.fotos[d.portada] ?? d.fotos[0];
const resto = d.fotos.filter((_, i) => i !== d.portada);
const lugar = ubicacionTexto(d.ubicacion.departamento, d.ubicacion.distrito);

const migas = migasDe(locale, [
	{ nombre: t("propiedades.titulo"), path: "/propiedades" },
	{ nombre: d.titulo },
]);

const mensaje = t("propiedades.mensajeWhatsapp", {
	codigo: d.referencia,
	titulo: d.titulo,
});

const disponible = d.estado === "disponible" || d.estado === "reservado";

const datos = [
	d.habitaciones !== undefined && {
		icono: "lucide:bed-double",
		valor: t("propiedades.habitaciones", { n: d.habitaciones }),
	},
	d.banos !== undefined && {
		icono: "lucide:bath",
		valor: t("propiedades.banos", { n: d.banos }),
	},
	d.parqueos > 0 && {
		icono: "lucide:car",
		valor: t("propiedades.parqueos", { n: d.parqueos }),
	},
	{
		icono: "lucide:ruler",
		valor: `${d.superficie.valor} ${etiqueta("unidadSuperficie", d.superficie.unidad, locale)}`,
	},
	d.superficieConstruidaM2 !== undefined && {
		icono: "lucide:home",
		valor: `${d.superficieConstruidaM2} m² ${t("propiedades.construido").toLowerCase()}`,
	},
	d.niveles !== undefined && {
		icono: "lucide:layers",
		valor: t("propiedades.niveles", { n: d.niveles }),
	},
].filter(Boolean) as Array<{ icono: string; valor: string }>;

/*
  Structured data. Declared as Product + Offer rather than RealEstateListing
  because Google understands Offer for price and availability, and that's
  what can end up showing in results.
*/
const esquemaAnuncio = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: d.titulo,
	description: d.descripcionCorta,
	sku: d.referencia,
	image: d.fotos.slice(0, 5).map((f) => f.ruta),
	...(d.ocultarPrecio
		? {}
		: {
				offers: {
					"@type": "Offer",
					price: d.precio,
					priceCurrency: "USD",
					availability: disponible
						? "https://schema.org/InStock"
						: "https://schema.org/SoldOut",
					url: new URL(Astro.url.pathname, site).href,
					seller: { "@id": `${new URL("/", site).href}#negocio` },
				},
			}),
	additionalProperty: [
		{ "@type": "PropertyValue", name: "Ubicación", value: lugar },
		{
			"@type": "PropertyValue",
			name: "Tipo",
			value: etiqueta("tipoPropiedad", d.tipo, locale),
		},
	],
};
---

<BaseLayout
	locale={locale}
	titulo={d.seo.titulo ?? d.titulo}
	descripcion={d.seo.descripcion ?? d.descripcionCorta}
	noindex={d.seo.noindex || d.borrador}
	esquemas={[esquemaAnuncio, esquemaMigas(migas, site)]}
>
	<article class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
		<nav aria-label="Migas de pan" class="text-muted-foreground mb-6 text-sm">
			<a href={localizedUrl("/propiedades", locale)} class="hover:text-foreground">
				{t("propiedades.titulo")}
			</a>
			<span class="mx-2">/</span>
			<span class="text-foreground">{d.referencia}</span>
		</nav>

		{
			d.borrador && (
				<Badge variant="outline" class="mb-4">
					Borrador
				</Badge>
			)
		}

		<!-- Galería: solo la principal es eager, el resto perezoso. -->
		<section class="grid gap-2 md:grid-cols-4" aria-label={t("propiedades.galeria")}>
			{
				portada && (
					<figure class="md:col-span-4 overflow-hidden rounded-xl">
						<R2Image
							src={portada.ruta}
							alt={portada.alt}
							anchos={[480, 960, 1600, 2400]}
							sizes="(min-width: 768px) 64rem, 100vw"
							ratio="3 / 2"
							loading="eager"
							fetchpriority="high"
						/>
					</figure>
				)
			}
			{
				resto.map((f) => (
					<figure class="overflow-hidden rounded-lg">
						<R2Image
							src={f.ruta}
							alt={f.alt}
							anchos={[240, 480]}
							sizes="(min-width: 768px) 16rem, 45vw"
							ratio="4 / 3"
						/>
					</figure>
				))
			}
		</section>

		<div class="mt-8 grid gap-10 lg:grid-cols-[1fr_20rem]">
			<div>
				<div class="flex flex-wrap items-center gap-2">
					<Badge variant="secondary">
						{etiqueta("operacion", d.operacion, locale)}
					</Badge>
					<Badge variant="secondary">
						{etiqueta("tipoPropiedad", d.tipo, locale)}
					</Badge>
					{
						d.estado !== "disponible" && (
							<Badge>{etiqueta("estadoPropiedad", d.estado, locale)}</Badge>
						)
					}
				</div>

				<h1 class="mt-3 font-serif text-3xl font-bold tracking-tight text-balance">
					{d.titulo}
				</h1>

				<p class="text-muted-foreground mt-2 flex items-center gap-1.5">
					<Icon name="lucide:map-pin" size={16} />
					{lugar}{d.ubicacion.zona ? ` · ${d.ubicacion.zona}` : ""}
				</p>

				<dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
					{
						datos.map((x) => (
							<div class="border-border bg-card flex items-center gap-2 rounded-lg border p-3">
								<Icon name={x.icono} size={18} class="text-muted-foreground" />
								<dd class="text-sm">{x.valor}</dd>
							</div>
						))
					}
				</dl>

				{
					d.amenidades.length > 0 && (
						<section class="mt-8">
							<h2 class="font-semibold">{t("propiedades.amenidades")}</h2>
							<ul class="mt-3 flex flex-wrap gap-2">
								{d.amenidades.map((a) => (
									<li>
										<Badge variant="outline">{etiqueta("amenidad", a, locale)}</Badge>
									</li>
								))}
							</ul>
						</section>
					)
				}

				<section class="mt-8">
					<h2 class="font-semibold">{t("propiedades.titulo")}</h2>
					<div class="text-muted-foreground mt-3 space-y-3 text-pretty">
						{d.descripcion.split("\n\n").map((p) => <p>{p}</p>)}
					</div>
				</section>
			</div>

			<!-- Precio y contacto -->
			<aside class="lg:sticky lg:top-20 lg:self-start">
				<div class="border-border bg-card rounded-xl border p-5">
					<p class="text-2xl font-bold">
						{
							d.ocultarPrecio
								? t("propiedades.consultarPrecio")
								: formatearPrecio(d.precio, locale)
						}
						{
							!d.ocultarPrecio && d.periodoPrecio === "mensual" && (
								<span class="text-muted-foreground text-base font-normal">
									{t("propiedades.porMes")}
								</span>
							)
						}
					</p>

					{
						d.precioNegociable && (
							<p class="text-muted-foreground mt-1 text-sm">
								{t("propiedades.negociable")}
							</p>
						)
					}

					{
						d.deposito !== undefined && d.deposito > 0 && (
							<p class="text-muted-foreground mt-1 text-sm">
								{t("vehiculos.deposito")}: {formatearPrecio(d.deposito, locale)}
							</p>
						)
					}

					<p class="text-muted-foreground mt-4 text-xs">
						{t("propiedades.codigo")}: <span class="font-mono">{d.referencia}</span>
					</p>

					<Button
						href={whatsappUrl(mensaje)}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-5 w-full"
						size="lg"
					>
						{t("propiedades.consultar")}
					</Button>

					{
						d.ubicacion.mapaUrl && (
							<a
								href={d.ubicacion.mapaUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="text-primary mt-3 block text-center text-sm hover:underline"
							>
								{t("propiedades.verEnMapa")} →
							</a>
						)
					}
				</div>
			</aside>
		</div>
	</article>
</BaseLayout>
