---
import { localePaths } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import { ETIQUETAS, etiqueta } from "@/i18n/enums";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FiltrosAnuncios from "@/components/listados/FiltrosAnuncios.svelte";
import {
	filtrosPropiedades,
	getTarjetasPropiedades,
	ordenesPropiedades,
} from "@/lib/anuncios";
import { DEPARTAMENTOS } from "@/lib/geo/el-salvador";
import { esquemaMigas, migasDe } from "@/lib/seo";

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://gutierrezgroup.blog");

const tarjetas = await getTarjetasPropiedades(locale);
const visibles = tarjetas.filter((x) => x.disponible);

const migas = migasDe(locale, [{ nombre: t("propiedades.titulo") }]);

const opcionesDe = (grupo: Parameters<typeof etiqueta>[0]) =>
	Object.keys(ETIQUETAS[grupo]).map((value) => ({
		value,
		label: etiqueta(grupo, value, locale),
	}));

const filtros = filtrosPropiedades((k) => t(`filtros.${k}` as never), {
	operacion: opcionesDe("operacion"),
	tipo: opcionesDe("tipoPropiedad"),
	departamento: DEPARTAMENTOS.map((d) => ({ value: d.id, label: d.nombre })),
});

const ordenes = ordenesPropiedades((k) => t(`filtros.orden.${k}` as never));

const textos = {
	titulo: t("filtros.titulo"),
	limpiar: t("filtros.limpiar"),
	buscar: t("filtros.buscar"),
	buscarPlaceholder: t("filtros.buscarPlaceholder"),
	ordenar: t("filtros.ordenar"),
	ver: t("filtros.ver"),
	ocultar: t("filtros.ocultar"),
	quitar: t("filtros.quitar"),
	activo: t("filtros.activo"),
	activos: t("filtros.activos"),
	todos: t("filtros.todos"),
	conteo: t("propiedades.conteo"),
	conteoUno: t("propiedades.conteoUno"),
	sinResultados: t("common.sinResultados"),
	sinResultadosAyuda: t("common.sinResultadosAyuda"),
	sinFoto: t("common.sinFoto"),
	consultarPrecio: t("propiedades.consultarPrecio"),
};

const listado = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: t("propiedades.titulo"),
	numberOfItems: visibles.length,
	itemListElement: visibles.map((x, i) => ({
		"@type": "ListItem",
		position: i + 1,
		name: x.titulo,
		url: new URL(x.href, site).href,
	})),
};
---

<BaseLayout
	locale={locale}
	titulo={t("propiedades.titulo")}
	descripcion={t("propiedades.descripcion")}
	esquemas={[esquemaMigas(migas, site), listado]}
>
	<section class="contenedor py-16 lg:py-20">
		<h1 class="aparece font-serif text-4xl font-normal tracking-tight sm:text-5xl">
			{t("propiedades.titulo")}
		</h1>
		<p class="aparece text-muted-foreground mt-4 max-w-[58ch] text-lg leading-relaxed">
			{t("propiedades.descripcion")}
		</p>

		<div class="mt-10">
			<FiltrosAnuncios
				client:load
				tarjetas={tarjetas}
				filtros={filtros}
				ordenes={ordenes}
				textos={textos}
			/>
		</div>
	</section>
</BaseLayout>
