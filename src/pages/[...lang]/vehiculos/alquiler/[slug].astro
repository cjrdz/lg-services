---
import { localePathsFor, localizedUrl } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import { etiqueta } from "@/i18n/enums";
import BaseLayout from "@/layouts/BaseLayout.astro";
import R2Image from "@/components/media/R2Image.astro";
import Icon from "@/components/Icon.astro";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { getVehiculos } from "@/lib/anuncios";
import { departamentoNombre } from "@/lib/geo/el-salvador";
import { formatearPrecio } from "@/lib/formato";
import { esquemaMigas, migasDe } from "@/lib/seo";
import { whatsappUrl } from "@/lib/sitio";

export async function getStaticPaths() {
	const vehiculos = await getVehiculos();
	return localePathsFor(
		vehiculos.map((v) => ({ params: { slug: v.id }, props: { vehiculo: v } })),
	);
}

const { vehiculo, locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://lisbethgutierrez.com");

const d = vehiculo.data;
const portada = d.fotos[d.portada] ?? d.fotos[0];
const resto = d.fotos.filter((_, i) => i !== d.portada);
const disponible = d.disponibilidad === "disponible";

const migas = migasDe(locale, [
	{ nombre: t("vehiculos.titulo"), path: "/vehiculos" },
	{ nombre: d.titulo },
]);

const mensaje = t("vehiculos.mensajeWhatsapp", {
	titulo: d.titulo,
	codigo: d.referencia,
});

const ficha = [
	{ icono: "lucide:calendar", etiqueta: t("vehiculos.anio"), valor: String(d.anio) },
	{
		icono: "lucide:car",
		etiqueta: t("vehiculos.categoria"),
		valor: etiqueta("categoriaVehiculo", d.categoria, locale),
	},
	{
		icono: "lucide:settings",
		etiqueta: t("vehiculos.transmision"),
		valor: etiqueta("transmision", d.transmision, locale),
	},
	{
		icono: "lucide:fuel",
		etiqueta: t("vehiculos.combustible"),
		valor: etiqueta("combustible", d.combustible, locale),
	},
	{
		icono: "lucide:users",
		etiqueta: t("vehiculos.pasajeros", { n: d.pasajeros }),
		valor: `${d.puertas} puertas`,
	},
	{
		icono: "lucide:luggage",
		etiqueta: t("vehiculos.maletas", { n: d.maletas }),
		valor: etiqueta("traccion", d.traccion, locale),
	},
];

const tarifas = [
	{ etiqueta: t("vehiculos.porDia"), monto: d.tarifaDiaria },
	d.tarifaSemanal !== undefined
		? { etiqueta: t("vehiculos.porSemana"), monto: d.tarifaSemanal }
		: null,
	d.tarifaMensual !== undefined
		? { etiqueta: t("vehiculos.porMes"), monto: d.tarifaMensual }
		: null,
].filter(Boolean) as Array<{ etiqueta: string; monto: number }>;

/*
  Product + Offer, same as propiedades: it's what Google understands for
  price and availability, and what can end up showing in results.
*/
const esquemaAnuncio = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: d.titulo,
	description: d.descripcionCorta,
	sku: d.referencia,
	brand: { "@type": "Brand", name: d.marca },
	model: d.modelo,
	image: d.fotos.slice(0, 5).map((f) => f.ruta),
	offers: {
		"@type": "Offer",
		price: d.tarifaDiaria,
		priceCurrency: "USD",
		availability: disponible
			? "https://schema.org/InStock"
			: "https://schema.org/OutOfStock",
		url: new URL(Astro.url.pathname, site).href,
		seller: { "@id": `${new URL("/", site).href}#negocio` },
	},
};
---

<BaseLayout
	locale={locale}
	titulo={d.seo.titulo ?? d.titulo}
	descripcion={d.seo.descripcion ?? d.descripcionCorta}
	noindex={d.seo.noindex || d.borrador}
	esquemas={[esquemaAnuncio, esquemaMigas(migas, site)]}
>
	<article class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
		<nav aria-label="Migas de pan" class="text-muted-foreground mb-6 text-sm">
			<a href={localizedUrl("/vehiculos", locale)} class="hover:text-foreground">
				{t("vehiculos.titulo")}
			</a>
			<span class="mx-2">/</span>
			<span class="text-foreground">{d.referencia}</span>
		</nav>

		{
			d.borrador && (
				<Badge variant="outline" class="mb-4">
					Borrador
				</Badge>
			)
		}

		<!-- Solo la principal es eager: es el LCP en un teléfono con datos móviles. -->
		<section class="grid gap-2 md:grid-cols-4" aria-label={t("vehiculos.galeria")}>
			{
				portada && (
					<figure class="overflow-hidden rounded-xl md:col-span-4">
						<R2Image
							src={portada.ruta}
							alt={portada.alt}
							anchos={[480, 960, 1600, 2400]}
							sizes="(min-width: 768px) 64rem, 100vw"
							ratio="3 / 2"
							loading="eager"
							fetchpriority="high"
						/>
					</figure>
				)
			}
			{
				resto.map((f) => (
					<figure class="overflow-hidden rounded-lg">
						<R2Image
							src={f.ruta}
							alt={f.alt}
							anchos={[240, 480]}
							sizes="(min-width: 768px) 16rem, 45vw"
							ratio="4 / 3"
						/>
					</figure>
				))
			}
		</section>

		<div class="mt-8 grid gap-10 lg:grid-cols-[1fr_20rem]">
			<div>
				<div class="flex flex-wrap items-center gap-2">
					<Badge variant="secondary">
						{etiqueta("categoriaVehiculo", d.categoria, locale)}
					</Badge>
					<Badge variant="secondary">{d.anio}</Badge>
					{
						!disponible && (
							<Badge>
								{etiqueta("disponibilidadVehiculo", d.disponibilidad, locale)}
							</Badge>
						)
					}
				</div>

				<h1 class="mt-3 font-serif text-3xl font-bold tracking-tight text-balance">
					{d.titulo}
				</h1>
				<p class="text-muted-foreground mt-2">{d.marca} {d.modelo}</p>

				<section class="mt-8">
					<h2 class="font-semibold">{t("vehiculos.fichaTecnica")}</h2>
					<dl class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
						{
							ficha.map((x) => (
								<div class="border-border bg-card flex items-center gap-2 rounded-lg border p-3">
									<Icon name={x.icono} size={18} class="text-muted-foreground" />
									<div class="min-w-0">
										<dt class="truncate text-sm">{x.etiqueta}</dt>
										<dd class="text-muted-foreground truncate text-xs">{x.valor}</dd>
									</div>
								</div>
							))
						}
					</dl>
				</section>

				<section class="mt-8">
					<h2 class="font-semibold">{t("vehiculos.titulo")}</h2>
					<div class="text-muted-foreground mt-3 space-y-3 text-pretty">
						{d.descripcion.split("\n\n").map((parrafo) => <p>{parrafo}</p>)}
					</div>
				</section>

				<section class="mt-8">
					<h2 class="font-semibold">{t("vehiculos.requisitos")}</h2>
					<ul class="text-muted-foreground mt-3 space-y-1.5 text-sm">
						{
							d.requisitos.map((r) => (
								<li class="flex items-start gap-2">
									<Icon name="lucide:check" size={16} class="mt-0.5 shrink-0" />
									{r}
								</li>
							))
						}
					</ul>
					<p class="text-muted-foreground mt-3 text-sm">
						{t("vehiculos.edadMinima", { n: d.edadMinima })} ·{" "}
						{
							d.kilometraje === "ilimitado"
								? t("vehiculos.kilometrajeIlimitado")
								: t("vehiculos.kilometrajeLimitado", { n: d.kmIncluidosPorDia ?? 0 })
						}
					</p>
				</section>
			</div>

			<aside class="lg:sticky lg:top-20 lg:self-start">
				<div class="border-border bg-card rounded-xl border p-5">
					<h2 class="text-sm font-semibold">{t("vehiculos.tarifas")}</h2>
					<dl class="mt-3 space-y-2">
						{
							tarifas.map((x, i) => (
								<div class="flex items-baseline justify-between gap-3">
									<dt class="text-muted-foreground text-sm">{x.etiqueta}</dt>
									<dd class:list={[i === 0 ? "text-xl font-bold" : "font-medium"]}>
										{formatearPrecio(x.monto, locale)}
									</dd>
								</div>
							))
						}
					</dl>

					{
						d.deposito > 0 && (
							<p class="text-muted-foreground mt-3 text-sm">
								{t("vehiculos.deposito")}: {formatearPrecio(d.deposito, locale)}
							</p>
						)
					}

					<p class="text-muted-foreground mt-4 text-sm">
						{t("vehiculos.entregaEn")}:{" "}
						{d.entrega.map((e) => departamentoNombre(e)).join(", ")}
					</p>

					<p class="text-muted-foreground mt-3 text-xs">
						{t("vehiculos.codigo")}: <span class="font-mono">{d.referencia}</span>
					</p>

					<Button
						href={whatsappUrl(mensaje)}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-5 w-full"
						size="lg"
					>
						{t("vehiculos.reservar")}
					</Button>
				</div>
			</aside>
		</div>
	</article>
</BaseLayout>
