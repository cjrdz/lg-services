---
import { getCollection, render } from "astro:content";
import { localePathsFor } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { formatearFecha } from "@/lib/formato";
import { esquemaMigas, migasDe } from "@/lib/seo";

/**
 * Legal pages (privacy notice, terms).
 *
 * Only published ones get generated in production: while a page is a
 * draft, its route doesn't exist, which is why the footer doesn't link it
 * yet either — `lint:links` would fail if it did.
 */
export async function getStaticPaths() {
	const mostrarBorradores = import.meta.env.DEV;
	const paginas = await getCollection(
		"paginas",
		({ data }) => mostrarBorradores || !data.borrador,
	);
	return localePathsFor(
		paginas.map((pagina) => ({ params: { slug: pagina.id }, props: { pagina } })),
	);
}

const { pagina, locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://gutierrezgroup.blog");

const d = pagina.data;
const { Content } = await render(pagina);
const migas = migasDe(locale, [{ nombre: d.titulo }]);
---

<BaseLayout
	locale={locale}
	titulo={d.seo.titulo ?? d.titulo}
	descripcion={d.seo.descripcion ?? d.descripcion}
	noindex={d.seo.noindex || d.borrador}
	esquemas={[esquemaMigas(migas, site)]}
>
	<article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
		{
			d.borrador && (
				<Badge variant="outline" class="mb-4">
					Borrador
				</Badge>
			)
		}

		<h1 class="font-serif text-4xl font-bold tracking-tight">{d.titulo}</h1>
		<p class="text-muted-foreground mt-3 text-sm">
			{t("common.actualizado")}: {formatearFecha(d.actualizado, locale)}
		</p>

		<div class="prose prose-neutral dark:prose-invert mt-10 max-w-none">
			<Content />
		</div>
	</article>
</BaseLayout>
