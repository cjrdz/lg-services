---
import { render } from "astro:content";
import { localePathsFor, localizedUrl } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { Badge } from "@/components/ui/badge";
import { getEntradas, formatearFecha, slugDe, tiempoLectura } from "@/lib/contenido";
import { areaTitulo } from "@/lib/taxonomia";
import { esquemaArticulo, esquemaMigas, migasDe } from "@/lib/seo";
import { whatsappUrl } from "@/lib/sitio";

export async function getStaticPaths() {
	// getEntradas already filters drafts based on the environment, so in
	// production a draft post doesn't even generate a route.
	const entradas = await getEntradas();
	return localePathsFor(
		entradas.map((entrada) => {
			// slugDe("es/derecho-laboral/demanda-laboral") -> "derecho-laboral/demanda-laboral"
			const [area, ...resto] = slugDe(entrada.id).split("/");
			return {
				params: { area, slug: resto.join("/") },
				props: { entrada },
			};
		}),
	);
}

const { entrada, locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://lisbethgutierrez.com");

const d = entrada.data;
const { Content } = await render(entrada);

const migas = migasDe(locale, [
	{ nombre: t("blog.titulo"), path: "/blog" },
	{ nombre: areaTitulo(d.area, locale), path: `/blog/${d.area}` },
	{ nombre: d.titulo },
]);

const minutos = tiempoLectura(entrada.body ?? "");
---

<BaseLayout
	locale={locale}
	titulo={d.seo.titulo ?? d.titulo}
	descripcion={d.seo.descripcion ?? d.descripcion}
	imagen={d.portada}
	noindex={d.seo.noindex || d.borrador}
	tipoOg="article"
	esquemas={[
		esquemaArticulo(
			{
				titulo: d.titulo,
				descripcion: d.descripcion,
				autor: d.autor,
				publicado: d.publicado,
				actualizado: d.actualizado,
				imagen: d.portada,
				area: areaTitulo(d.area, locale),
			},
			Astro.url.pathname,
			site,
		),
		esquemaMigas(migas, site),
	]}
>
	{
		/*
	  Reading progress. Fixed to the top of the viewport, under the navbar,
	  and driven entirely by CSS `animation-timeline: scroll()` — no listener
	  and no work on the scroll thread. Decorative for a screen reader: the
	  same information is the scrollbar's job.
	*/
	}
	<div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5">
		<div class="barra-progreso bg-primary h-full w-full"></div>
	</div>

	<article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
		<nav aria-label="Migas de pan" class="text-muted-foreground mb-6 text-sm">
			<a href={localizedUrl("/blog", locale)} class="hover:text-foreground">
				{t("blog.titulo")}
			</a>
			<span class="mx-2">/</span>
			<a href={localizedUrl(`/blog/${d.area}`, locale)} class="hover:text-foreground">
				{areaTitulo(d.area, locale)}
			</a>
		</nav>

		{
			d.borrador && (
				<Badge variant="outline" class="mb-4">
					{t("common.borrador")}
				</Badge>
			)
		}

		<h1 class="font-serif text-4xl font-bold tracking-tight text-balance">
			{d.titulo}
		</h1>

		<p class="text-muted-foreground mt-4 text-lg text-pretty">{d.descripcion}</p>

		<div class="text-muted-foreground mt-6 flex flex-wrap items-center gap-2 text-sm">
			<span>{t("blog.porAutor", { autor: d.autor })}</span>
			<span>·</span>
			<time datetime={d.publicado.toISOString()}>
				{formatearFecha(d.publicado, locale)}
			</time>
			<span>·</span>
			{/* `tiempoLectura()` y `common.minutosLectura` ya existían sin usarse. */}
			<span>{t("common.minutosLectura", { n: minutos })}</span>
			{
				d.actualizado && (
					<>
						<span>·</span>
						<span>
							{t("common.actualizado")} {formatearFecha(d.actualizado, locale)}
						</span>
					</>
				)
			}
		</div>

		<div class="prose prose-neutral dark:prose-invert mt-10 max-w-none">
			<Content />
		</div>

		{
			d.etiquetas.length > 0 && (
				<footer class="border-border revelar mt-12 flex flex-wrap gap-2 border-t pt-6">
					{d.etiquetas.map((etiqueta) => (
						<Badge variant="secondary">{etiqueta}</Badge>
					))}
				</footer>
			)
		}

		{
			/*
		  Cierre del artículo. Quien llegó hasta acá leyendo sobre un despido
		  injustificado es exactamente quien puede necesitar una consulta —
		  antes la página terminaba en las etiquetas y no ofrecía nada.
		*/
		}
		<section class="revelar border-border bg-card mt-12 rounded-xl border p-6 sm:p-8">
			<h2 class="font-serif text-xl font-bold">{t("blog.ctaTitulo")}</h2>
			<p class="text-muted-foreground mt-2 text-sm">{t("blog.ctaTexto")}</p>

			<div class="mt-5 flex flex-wrap gap-3">
				<a
					href={whatsappUrl(
						t("servicios.consultar", { area: areaTitulo(d.area, locale) }),
					)}
					target="_blank"
					rel="noopener noreferrer"
					class="bg-primary text-primary-foreground group elevable inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-medium"
				>
					<Icon name="lucide:message-circle" size={15} />
					{t("common.whatsapp")}
				</a>

				<a
					href={localizedUrl(`/blog/${d.area}`, locale)}
					class="border-border bg-background hover:border-primary/40 hover:text-primary group elevable inline-flex items-center gap-1.5 rounded-lg border px-4 py-2 text-sm font-medium"
				>
					{t("blog.volverAlArea", { area: areaTitulo(d.area, locale) })}
					<Icon name="lucide:arrow-right" size={15} class="flecha-desliza" />
				</a>
			</div>
		</section>
	</article>
</BaseLayout>
