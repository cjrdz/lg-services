---
import { localePathsFor, localizedUrl } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import TarjetaEntrada from "@/components/blog/TarjetaEntrada.astro";
import { getEntradasPorArea, slugDe } from "@/lib/contenido";
import { AREAS, AREA_IDS, areaCopy } from "@/lib/taxonomia";
import { esquemaMigas, migasDe } from "@/lib/seo";

export async function getStaticPaths() {
	return localePathsFor(
		AREA_IDS.map((area) => ({ params: { area }, props: { area } })),
	);
}

const { area, locale } = Astro.props as {
	area: (typeof AREA_IDS)[number];
	locale: "es";
};

const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://gutierrezgroup.blog");

const copy = areaCopy(area, locale);
const entradas = await getEntradasPorArea(area, locale);

const migas = migasDe(locale, [
	{ nombre: t("blog.titulo"), path: "/blog" },
	{ nombre: copy.titulo },
]);

const coleccion = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: t("blog.enArea", { area: copy.titulo }),
	description: copy.seoDescripcion,
	url: new URL(localizedUrl(`/blog/${area}`, locale), site).href,
	mainEntity: {
		"@type": "ItemList",
		numberOfItems: entradas.length,
		itemListElement: entradas.map((e, i) => ({
			"@type": "ListItem",
			position: i + 1,
			item: {
				"@type": "BlogPosting",
				headline: e.data.titulo,
				description: e.data.descripcion,
				datePublished: e.data.publicado.toISOString(),
				url: new URL(localizedUrl(`/blog/${slugDe(e.id)}`, locale), site).href,
				author: { "@type": "Person", name: e.data.autor },
			},
		})),
	},
};
---

<BaseLayout
	locale={locale}
	titulo={t("blog.enArea", { area: copy.titulo })}
	descripcion={copy.seoDescripcion}
	esquemas={[coleccion, esquemaMigas(migas, site)]}
>
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<nav aria-label="Migas de pan" class="text-muted-foreground mb-6 text-sm">
			<a href={localizedUrl("/blog", locale)} class="hover:text-foreground">
				{t("blog.titulo")}
			</a>
			<span class="mx-2">/</span>
			<span class="text-foreground">{copy.titulo}</span>
		</nav>

		{
			/* El otro extremo del morph: el mismo nombre que la tarjeta de esta
			    área en /blog. */
		}
		<span
			transition:name={`blog-area-icono-${area}`}
			class="bg-secondary text-secondary-foreground mb-4 inline-flex size-12 items-center justify-center rounded-xl"
		>
			<Icon name={AREAS[area].icono} size={24} />
		</span>

		<h1 class="aparece font-serif text-4xl font-bold tracking-tight">
			{t("blog.enArea", { area: copy.titulo })}
		</h1>
		<p class="aparece text-muted-foreground mt-3 max-w-2xl text-lg">{copy.resumen}</p>

		{
			entradas.length > 0 ? (
				<div class="revelar-grupo mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{entradas.map((entrada) => (
						<TarjetaEntrada entrada={entrada} locale={locale} />
					))}
				</div>
			) : (
				<div class="border-border bg-muted/30 mt-10 rounded-xl border border-dashed p-10 text-center">
					<p class="font-medium">{t("blog.vacio")}</p>
					<p class="text-muted-foreground mt-1 text-sm">{t("blog.vacioAyuda")}</p>
				</div>
			)
		}

		{
			/*
		  Cierre de la página: quien terminó de leer las publicaciones de un
		  área es justo quien puede necesitar la asesoría de esa área. Antes
		  era un enlace de texto suelto con una flecha escrita a mano.
		*/
		}
		<div
			class="revelar border-border bg-card mt-12 flex flex-wrap items-center justify-between gap-4 rounded-xl border p-6"
		>
			<div>
				<h2 class="font-semibold">{t("blog.ctaTitulo")}</h2>
				<p class="text-muted-foreground mt-1 text-sm">{t("blog.ctaTexto")}</p>
			</div>
			<a
				href={localizedUrl(`/servicios/${area}`, locale)}
				class="border-border bg-background hover:border-primary/40 hover:text-primary group elevable inline-flex shrink-0 items-center gap-1.5 rounded-lg border px-4 py-2 text-sm font-medium"
			>
				{t("servicios.consultar", { area: copy.titulo })}
				<Icon name="lucide:arrow-right" size={15} class="flecha-desliza" />
			</a>
		</div>
	</section>
</BaseLayout>
