---
import { localePaths, localizedUrl } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import TarjetaEntrada from "@/components/blog/TarjetaEntrada.astro";
import { conteoPorArea, getEntradas } from "@/lib/contenido";
import { AREAS, areasOrdenadas } from "@/lib/taxonomia";
import { esquemaMigas, migasDe } from "@/lib/seo";
import { SITIO } from "@/lib/sitio";

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://gutierrezgroup.blog");

const entradas = await getEntradas(locale);
const recientes = entradas.slice(0, 6);
const conteo = await conteoPorArea(locale);
const areas = areasOrdenadas(locale);

const migas = migasDe(locale, [{ nombre: t("blog.titulo") }]);

const esquemaBlog = {
	"@context": "https://schema.org",
	"@type": "Blog",
	name: t("blog.titulo"),
	description: t("blog.descripcion"),
	url: new URL(localizedUrl("/blog", locale), site).href,
	inLanguage: "es-SV",
	publisher: { "@id": `${new URL("/", site).href}#negocio` },
	author: { "@type": "Person", name: SITIO.nombreLegal },
};
---

<BaseLayout
	locale={locale}
	titulo={t("blog.titulo")}
	descripcion={t("blog.descripcion")}
	esquemas={[esquemaBlog, esquemaMigas(migas, site)]}
>
	<section class="contenedor py-16 lg:py-20">
		<h1 class="aparece font-serif text-4xl font-normal tracking-tight sm:text-5xl">
			{t("blog.titulo")}
		</h1>
		<p class="aparece text-muted-foreground mt-4 max-w-[58ch] text-lg leading-relaxed">
			{t("blog.descripcion")}
		</p>

		{
			recientes.length > 0 ? (
				<>
					<h2 class="mt-12 font-serif text-2xl font-normal">{t("blog.recientes")}</h2>
					<div class="aparece-escalonado mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						{recientes.map((entrada) => (
							<TarjetaEntrada entrada={entrada} locale={locale} />
						))}
					</div>
				</>
			) : (
				<div class="border-border bg-muted/30 mt-12 rounded-lg border border-dashed p-10 text-center">
					<p class="font-medium">{t("blog.vacio")}</p>
					<p class="text-muted-foreground mt-1 text-sm">{t("blog.vacioAyuda")}</p>
				</div>
			)
		}

		<h2 class="revelar mt-16 font-serif text-2xl font-normal">
			{t("blog.categorias")}
		</h2>
		<div class="rejilla-hilo revelar-grupo mt-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				areas.map((area) => {
					const n = conteo[area.id] ?? 0;
					const vacia = n === 0;
					return (
						<a
							href={vacia ? undefined : localizedUrl(`/blog/${area.id}`, locale)}
							aria-disabled={vacia ? "true" : undefined}
							class:list={[
								"bg-card group relative p-6",
								vacia
									? "pointer-events-none opacity-60"
									: "hover:bg-secondary elevable",
							]}
						>
							{/*
							  El mismo nombre que el ícono en la cabecera de esa área, así que
							  entrar a ella transforma el ícono chico en el grande en vez de
							  fundirlo. Namespace propio, aparte de `area-icono-*` (home y
							  /servicios): son otro par, y dos elementos con el mismo nombre en
							  una misma página anulan la transición entera.
							*/}
							<span
								transition:name={`blog-area-icono-${area.id}`}
								class:list={[
									"bg-secondary text-secondary-foreground color-animado mb-4 inline-flex size-10 items-center justify-center rounded-sm",
									!vacia &&
										"group-hover:bg-primary group-hover:text-primary-foreground",
								]}
							>
								<Icon name={AREAS[area.id].icono} size={20} />
							</span>
							<h3 class="text-primary font-serif text-[1.3rem] leading-tight font-medium">
								{area.titulo}
							</h3>
							<p class="text-muted-foreground mt-1 text-sm">{area.resumen}</p>
							<p class="text-muted-foreground mt-3 text-xs">
								{vacia
									? t("common.proximamente")
									: n === 1
										? t("blog.publicacion")
										: t("blog.publicaciones", { n })}
							</p>

							{/* An area with nothing in it isn't a link, so it gets no arrow. */}
							{!vacia && (
								<Icon
									name="lucide:arrow-right"
									size={16}
									class="text-primary flecha-tarjeta absolute right-5 bottom-5"
								/>
							)}
						</a>
					);
				})
			}
		</div>
	</section>
</BaseLayout>
