---
import { localizedUrl, resolveLocale } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ImagenLocal from "@/components/ImagenLocal.astro";
import { Button } from "@/components/ui/button";
import * as Card from "@/components/ui/card";
import { CONTACTO, SITIO, mailtoUrl, telUrl, whatsappUrl } from "@/lib/sitio";
import FormularioContacto from "@/components/contacto/FormularioContacto.svelte";
import { esquemaMigas, migasDe } from "@/lib/seo";
import { getCollection } from "astro:content";

/*
  ON-DEMAND page, not prerendered.

  The only one on the site that needs it: without JavaScript, the endpoint
  responds 303 and returns here with ?envio=ok|error, and a static page can't
  read the query on the server — the "we got your inquiry" notice would
  never appear.

  With `prerender = false`, `getStaticPaths` is ignored (Astro warns about
  it), so the locale comes from the URL's own param instead.
*/
export const prerender = false;

const locale = resolveLocale(Astro.params.lang);
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://gutierrezgroup.blog");

const migas = migasDe(locale, [{ nombre: t("contacto.titulo") }]);

/*
  Submit result with NO JavaScript: the endpoint responds 303 and returns
  here with ?envio=ok|error. With JS, the island intercepts and this is never used.
*/
const envio = Astro.url.searchParams.get("envio");
const motivoError = Astro.url.searchParams.get("motivo");

const textosFormulario = {
	nombre: t("formulario.nombre"),
	correo: t("formulario.correo"),
	telefono: t("formulario.telefono"),
	asunto: t("formulario.asunto"),
	mensaje: t("formulario.mensaje"),
	privacidad: t("formulario.privacidad"),
	enviar: t("formulario.enviar"),
	enviando: t("formulario.enviando"),
	exito: t("formulario.exito"),
	error: t("formulario.error"),
	whatsapp: t("common.whatsapp"),
	privacidadPrefijo: t("formulario.privacidadPrefijo"),
	privacidadEnlace: t("formulario.privacidadEnlace"),
	privacidadSufijo: t("formulario.privacidadSufijo"),
};

// Without a key, the widget doesn't render: the form still works via the honeypot.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as
	string | undefined;

/*
  The checkbox only links to the privacy notice if the page is PUBLISHED.
  Until Lisbeth writes it, the text stays link-less instead of pointing at a
  404 — and `lint:links` has nothing to complain about.
*/
const paginasLegales = await getCollection("paginas", ({ data }) => !data.borrador);
const avisoPrivacidad = paginasLegales.find((x) => x.id === "aviso-privacidad");
const avisoPrivacidadUrl = avisoPrivacidad
	? localizedUrl(`/legal/${avisoPrivacidad.id}`, locale)
	: undefined;

const tarjetas = [
	{
		icono: "lucide:phone",
		titulo: t("contacto.telefono"),
		valor: CONTACTO.telefono,
		href: telUrl(),
	},
	{
		icono: "lucide:message-circle",
		titulo: "WhatsApp",
		valor: t("common.whatsapp"),
		href: whatsappUrl(),
		externo: true,
	},
	{
		icono: "lucide:mail",
		titulo: t("contacto.correo"),
		valor: CONTACTO.correo,
		href: mailtoUrl("Consulta legal"),
	},
	{
		icono: "lucide:map-pin",
		titulo: t("contacto.direccion"),
		valor: CONTACTO.direccion,
	},
];
---

<BaseLayout
	locale={locale}
	titulo={t("contacto.titulo")}
	descripcion={t("contacto.descripcion")}
	esquemas={[esquemaMigas(migas, site)]}
>
	<section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
		<div class="grid items-center gap-8 sm:grid-cols-[1fr_auto]">
			<div>
				<h1 class="aparece font-serif text-4xl font-bold tracking-tight">
					{t("contacto.titulo")}
				</h1>
				<p class="aparece text-muted-foreground mt-3 text-lg">
					{t("contacto.descripcion")}
				</p>
			</div>
			<div
				class="aparece border-border/60 bg-muted w-40 overflow-hidden rounded-2xl border shadow-lg sm:w-48"
			>
				<ImagenLocal
					src="/src/assets/images/contact.jpg"
					alt={`${SITIO.nombre}, ${SITIO.profesion.toLowerCase()}`}
					contexto="retrato de la página de contacto"
					ratio="3 / 4"
					widths={[200, 400, 600]}
					sizes="(min-width: 640px) 12rem, 10rem"
				/>
			</div>
		</div>

		{
			/*
		  Las cuatro vías de contacto. Tres son enlaces y una es un dato: las
		  que se pueden tocar se elevan, cambian de color y muestran la flecha;
		  la dirección no, porque no lleva a ningún lado.
		*/
		}
		<div class="revelar-grupo mt-10 grid gap-4 sm:grid-cols-2">
			{
				tarjetas.map((c) => {
					const contenido = (
						<>
							<span class="bg-secondary text-secondary-foreground color-animado mb-3 inline-flex size-10 items-center justify-center rounded-lg group-hover:bg-primary group-hover:text-primary-foreground">
								<Icon name={c.icono} size={20} />
							</span>
							<h2 class="group-hover:text-primary text-sm font-semibold transition-colors">
								{c.titulo}
							</h2>
							<p class="text-muted-foreground mt-1 text-sm">{c.valor}</p>
						</>
					);

					return c.href ? (
						<a
							href={c.href}
							target={c.externo ? "_blank" : undefined}
							rel={c.externo ? "noopener noreferrer" : undefined}
							class="border-border bg-card hover:border-primary/40 group elevable relative rounded-xl border p-5"
						>
							{contenido}
							<Icon
								name="lucide:arrow-right"
								size={16}
								class="text-primary flecha-tarjeta absolute right-5 bottom-5"
							/>
						</a>
					) : (
						<div class="border-border bg-card rounded-xl border p-5">{contenido}</div>
					);
				})
			}
		</div>

		<Card.Root class="mt-8">
			<Card.Header>
				<Card.Title>{t("contacto.urgente")}</Card.Title>
				<Card.Description>{t("contacto.urgenteTexto")}</Card.Description>
			</Card.Header>
			<Card.Content class="flex flex-wrap gap-3">
				<Button href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
					{t("common.whatsapp")}
				</Button>
				<Button href={telUrl()} variant="outline">{t("common.llamar")}</Button>
			</Card.Content>
		</Card.Root>

		{
			/*
		  El formulario dentro de una tarjeta, como todo lo demás de la página.
		  Suelto sobre el fondo no se leía como una unidad: los campos
		  flotaban y no quedaba claro dónde empezaba y dónde terminaba.
		*/
		}
		<section class="revelar border-border bg-card mt-12 rounded-xl border p-6 sm:p-8">
			<h2 class="font-serif text-2xl font-bold">{t("formulario.enviar")}</h2>

			{
				envio === "ok" && (
					<p
						class="border-success bg-success/10 mt-4 rounded-lg border px-4 py-3 text-sm"
						role="status"
					>
						{t("formulario.exito")}
					</p>
				)
			}
			{
				envio === "error" && (
					<p
						class="border-destructive bg-destructive/10 mt-4 rounded-lg border px-4 py-3 text-sm"
						role="alert"
					>
						{motivoError ?? t("formulario.error")}{" "}
						<a
							href={whatsappUrl()}
							target="_blank"
							rel="noopener noreferrer"
							class="underline"
						>
							{t("common.whatsapp")}
						</a>
					</p>
				)
			}

			<div class="mt-6">
				<FormularioContacto
					client:load
					motivos={CONTACTO.motivosContacto}
					textos={textosFormulario}
					whatsapp={whatsappUrl()}
					turnstileSiteKey={turnstileSiteKey}
					avisoPrivacidadUrl={avisoPrivacidadUrl}
				/>
			</div>
		</section>

		<div class="revelar border-border bg-card mt-10 rounded-xl border p-6">
			<h2 class="flex items-center gap-2 text-lg font-semibold">
				<Icon name="lucide:clock" size={18} class="text-muted-foreground" />
				{t("contacto.horario")}
			</h2>
			<ul class="text-muted-foreground mt-3 space-y-1">
				{
					CONTACTO.horario.map((h) => (
						<li class="flex flex-wrap justify-between gap-x-4 gap-y-0.5">
							<span class="text-foreground font-medium">{h.dias}</span>
							<span>{h.horas}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
