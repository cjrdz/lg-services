---
import { localizedUrl, resolveLocale } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ImagenLocal from "@/components/ImagenLocal.astro";
import { CONTACTO, SITIO, mailtoUrl, telUrl, whatsappUrl } from "@/lib/sitio";
import FormularioContacto from "@/components/contacto/FormularioContacto.svelte";
import { esquemaMigas, migasDe } from "@/lib/seo";
import { getCollection } from "astro:content";

/*
  ON-DEMAND page, not prerendered.

  The only one on the site that needs it: without JavaScript, the endpoint
  responds 303 and returns here with ?envio=ok|error, and a static page can't
  read the query on the server — the "we got your inquiry" notice would
  never appear. The home's copy of this form posts here for the same reason.

  With `prerender = false`, `getStaticPaths` is ignored (Astro warns about
  it), so the locale comes from the URL's own param instead.
*/
export const prerender = false;

const locale = resolveLocale(Astro.params.lang);
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://gutierrezgroup.blog");

const migas = migasDe(locale, [{ nombre: t("contacto.titulo") }]);

/*
  Submit result with NO JavaScript: the endpoint responds 303 and returns
  here with ?envio=ok|error. With JS, the island intercepts and this is never used.
*/
const envio = Astro.url.searchParams.get("envio");
const motivoError = Astro.url.searchParams.get("motivo");

const textosFormulario = {
	nombre: t("formulario.nombre"),
	correo: t("formulario.correo"),
	telefono: t("formulario.telefono"),
	asunto: t("formulario.asunto"),
	mensaje: t("formulario.mensaje"),
	privacidad: t("formulario.privacidad"),
	enviar: t("formulario.enviar"),
	enviando: t("formulario.enviando"),
	exito: t("formulario.exito"),
	error: t("formulario.error"),
	whatsapp: t("common.whatsapp"),
	privacidadPrefijo: t("formulario.privacidadPrefijo"),
	privacidadEnlace: t("formulario.privacidadEnlace"),
	privacidadSufijo: t("formulario.privacidadSufijo"),
};

// Without a key, the widget doesn't render: the form still works via the honeypot.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as
	string | undefined;

/*
  The checkbox only links to the privacy notice if the page is PUBLISHED.
  Until Lisbeth writes it, the text stays link-less instead of pointing at a
  404 — and `lint:links` has nothing to complain about.
*/
const paginasLegales = await getCollection("paginas", ({ data }) => !data.borrador);
const avisoPrivacidad = paginasLegales.find((x) => x.id === "aviso-privacidad");
const avisoPrivacidadUrl = avisoPrivacidad
	? localizedUrl(`/legal/${avisoPrivacidad.id}`, locale)
	: undefined;

/*
  Rows, not a grid of four cards. Three of them are actions and one is a fact,
  which a card grid flattened into looking like four identical buttons.
*/
const filas = [
	{ etiqueta: t("contacto.telefono"), valor: CONTACTO.telefono, href: telUrl() },
	{
		etiqueta: "WhatsApp",
		valor: t("common.whatsapp"),
		href: whatsappUrl(),
		externo: true,
	},
	{
		etiqueta: t("contacto.correo"),
		valor: CONTACTO.correo,
		href: mailtoUrl("Consulta legal"),
	},
	{ etiqueta: t("contacto.direccion"), valor: CONTACTO.direccion },
];
---

<BaseLayout
	locale={locale}
	titulo={t("contacto.titulo")}
	descripcion={t("contacto.descripcion")}
	esquemas={[esquemaMigas(migas, site)]}
>
	<section class="border-border border-b">
		<div class="contenedor py-14 lg:py-16">
			<h1 class="font-serif text-4xl font-normal tracking-tight sm:text-5xl">
				{t("contacto.titulo")}
			</h1>
			<p class="text-muted-foreground mt-4 max-w-[54ch] text-lg leading-relaxed">
				{t("contacto.descripcion")}
			</p>
		</div>
	</section>

	<div class="contenedor grid gap-12 py-14 lg:grid-cols-[1fr_1.1fr] lg:py-16">
		<div class="revelar min-w-0">
			<dl>
				{
					filas.map((f) => (
						<div class="border-border flex justify-between gap-6 border-t py-4 last:border-b">
							<dt class="text-muted-foreground shrink-0 text-xs font-semibold tracking-[0.1em] uppercase">
								{f.etiqueta}
							</dt>
							<dd class="min-w-0 text-right text-[0.97rem]">
								{f.href ? (
									<a
										href={f.href}
										target={f.externo ? "_blank" : undefined}
										rel={f.externo ? "noopener noreferrer" : undefined}
										class="hover:text-primary color-animado break-all tabular-nums"
									>
										{f.valor}
									</a>
								) : (
									f.valor
								)}
							</dd>
						</div>
					))
				}
			</dl>

			<h2
				class="text-muted-foreground mt-10 text-xs font-bold tracking-[0.12em] uppercase"
			>
				{t("contacto.horario")}
			</h2>
			<dl class="border-border mt-4 border-t">
				{
					CONTACTO.horario.map((h) => (
						<div class="border-border flex flex-wrap justify-between gap-x-6 gap-y-1 border-b py-3 text-[0.97rem]">
							<dt class="font-medium">{h.dias}</dt>
							<dd class="text-muted-foreground tabular-nums">{h.horas}</dd>
						</div>
					))
				}
			</dl>

			<div
				class="border-border retrato-velo bg-muted mt-10 max-w-64 overflow-hidden border"
			>
				<ImagenLocal
					src="/src/assets/images/contact.jpg"
					alt={`${SITIO.nombreLegal}, ${SITIO.profesion.toLowerCase()}`}
					contexto="retrato de la página de contacto"
					ratio="3 / 4"
					widths={[200, 400, 600]}
					sizes="(min-width: 640px) 16rem, 60vw"
					class="retrato-neutro"
				/>
			</div>
		</div>

		<section
			class="revelar border-border bg-secondary min-w-0 rounded-lg border p-6 sm:p-8"
		>
			<h2 class="font-serif text-2xl font-normal tracking-tight">
				{t("formulario.enviar")}
			</h2>

			{
				envio === "ok" && (
					<p
						class="border-success bg-success/10 mensaje-animado mt-4 rounded-lg border px-4 py-3 text-sm"
						role="status"
					>
						{t("formulario.exito")}
					</p>
				)
			}
			{
				envio === "error" && (
					<p
						class="border-destructive bg-destructive/10 mensaje-animado mt-4 rounded-lg border px-4 py-3 text-sm"
						role="alert"
					>
						{motivoError ?? t("formulario.error")}{" "}
						<a
							href={whatsappUrl()}
							target="_blank"
							rel="noopener noreferrer"
							class="underline"
						>
							{t("common.whatsapp")}
						</a>
					</p>
				)
			}

			<div class="mt-6">
				<FormularioContacto
					client:load
					motivos={CONTACTO.motivosContacto}
					textos={textosFormulario}
					whatsapp={whatsappUrl()}
					turnstileSiteKey={turnstileSiteKey}
					avisoPrivacidadUrl={avisoPrivacidadUrl}
				/>
			</div>
		</section>
	</div>
</BaseLayout>
