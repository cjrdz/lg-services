---
import { r2Srcset, r2Url } from "@/lib/media/r2";
import { ANCHOS_GALERIA } from "@/lib/media/keys";
import Icon from "@/components/Icon.astro";

/**
 * A listing's photo, served from R2.
 *
 * Emits a plain <img srcset> pointing at files that ALREADY exist — Lisbeth's
 * browser generated the WebP files at upload time. Deliberately bypasses
 * astro:assets: <Picture> would require declaring remotePatterns and
 * round-tripping every photo through sharp on every build, which at a
 * thousand photos turns the build into several minutes re-optimizing bytes
 * that were already optimized.
 *
 * No width/height: unknowable without fetching the image. aspect-ratio on a
 * container with object-cover avoids the layout shift anyway.
 *
 * For REPO images (portrait, office) use <ImagenLocal> instead, which does
 * go through astro:assets.
 *
 * SIN BUCKET CONFIGURADO, ESTO DIBUJA UN PLACEHOLDER, NO NADA.
 *
 * `r2Url()` devuelve `""` cuando `PUBLIC_MEDIA_BASE_URL` no está puesta —
 * pasa en desarrollo siempre, y puede pasar en producción a medio configurar
 * (ver SETUP-R2.md). La versión anterior de este componente, con solo
 * `{fallback && <img/>}`, no renderizaba NADA en ese caso: ni una caja, ni el
 * `<img>`. En una galería (`grid grid-cols-2 md:grid-cols-4`), eso es una
 * `<figure>` de alto CERO — un hueco invisible en la grilla, sin ninguna
 * pista de que ahí falta una foto. Encontrado con Playwright inyectando el
 * markup real: el elemento medía 0×0 mientras el `<figure>` que lo envuelve
 * seguía ocupando su columna.
 *
 * `<TarjetaAnuncio>` (la tarjeta de listado) ya resolvía esto con su propio
 * `{#if}/{:else}` — un cuadro del tamaño correcto con el texto "Sin foto".
 * Esto hace lo mismo acá, para que los dos componentes de imagen del sitio
 * fallen de la misma manera: el `aspect-ratio` se aplica igual en los dos
 * casos, así que la grilla nunca colapsa, tenga foto o no.
 */
interface Props {
	src: string;
	alt: string;
	anchos?: readonly number[];
	sizes?: string;
	ratio?: string;
	loading?: "lazy" | "eager";
	fetchpriority?: "high" | "low" | "auto";
	/**
	 * `view-transition-name` de esta foto. En la ficha de un anuncio va la
	 * portada, para que la foto de la tarjeta crezca hasta acá en vez de que
	 * la página corte. Ver `transicionFoto()` en src/lib/formato.ts.
	 */
	transicion?: string;
	class?: string;
}

const {
	src,
	alt,
	anchos = ANCHOS_GALERIA,
	sizes = "(min-width: 1024px) 50vw, 100vw",
	ratio = "4 / 3",
	loading = "lazy",
	fetchpriority = "auto",
	transicion,
	class: className,
} = Astro.props;

const mayor = anchos[anchos.length - 1];
const fallback = r2Url(src, mayor);

const estilo = [
	`aspect-ratio:${ratio}`,
	transicion && `view-transition-name:${transicion}`,
]
	.filter(Boolean)
	.join(";");
---

{
	fallback ? (
		<img
			src={fallback}
			srcset={r2Srcset(src, anchos)}
			sizes={sizes}
			alt={alt}
			loading={loading}
			decoding="async"
			fetchpriority={fetchpriority}
			style={estilo}
			class:list={["bg-muted h-full w-full object-cover", className]}
		/>
	) : (
		<div
			style={estilo}
			class:list={[
				"bg-muted text-muted-foreground flex w-full items-center justify-center",
				className,
			]}
		>
			<Icon name="lucide:image-off" size={28} label={alt} />
		</div>
	)
}
