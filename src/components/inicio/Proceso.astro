---
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n";
import Antetitulo from "@/components/Antetitulo.astro";

interface Props {
	locale: Locale;
	intro?: string;
	pasos: ReadonlyArray<{ titulo: string; descripcion: string }>;
}

const { locale, intro, pasos } = Astro.props;
const t = useTranslations(locale);
---

{
	/*
	  The whole band disappears when there are no steps. `procesoPasos` is a
	  Keystatic array with no minimum, so "Lisbeth emptied it" has to render as
	  nothing at all — not as a heading with a blank column under it.
	*/
}
{
	pasos.length > 0 && (
		<section class="bg-banda text-banda-foreground">
			<div class="contenedor grid gap-12 py-16 lg:grid-cols-[1fr_1.25fr] lg:py-20">
				<div class="revelar">
					<Antetitulo heredaColor conRegla={false}>
						{t("home.proceso.antetitulo")}
					</Antetitulo>
					<h2 class="text-banda-titulo mt-4 font-serif text-3xl leading-tight font-normal text-balance sm:text-4xl">
						{t("home.proceso.titulo")}
					</h2>
					{intro && (
						<p class="mt-5 max-w-[40ch] text-[1.05rem] leading-relaxed">{intro}</p>
					)}
				</div>

				{/*
			  Los pasos entran DE COSTADO, no desde abajo, y por eso no usan
			  `.revelar-grupo` como el resto del sitio.

			  La diferencia no es decorativa. Todo lo demás en la página es una
			  grilla de tarjetas: bloques independientes que aparecen, y para eso
			  subir desde abajo está bien. Esto es una SECUENCIA — 01, después 02,
			  después 03 — y el movimiento horizontal es el que dice "esto avanza"
			  en vez de "esto aparece". Cada paso llega desde la derecha, que es
			  el lado por el que se sigue leyendo.

			  NO hay un desfase escrito por paso, y eso es deliberado. Cada `<li>`
			  tiene su propia línea de tiempo `view()`, que depende de DÓNDE ESTÁ
			  en la página, así que el escalonamiento ya viene puesto: 02 está un
			  paso más abajo que 01 y por eso entra después. Un desfase a mano
			  encima de eso llegaba tarde —el último paso seguía a media opacidad
			  cuando ya se podía leer entero— y además estaba capado al tercero
			  (`i === 1 ? ... : ...`), así que con cinco pasos el tercero, el
			  cuarto y el quinto habrían entrado todos juntos.

			  Sin él, esto funciona con los pasos que sean: agregá un cuarto en
			  /keystatic y entra en su turno, sin tocar una línea de CSS.

			  Lo que se mueve es el CONTENIDO, no la fila: el `<li>` lleva la regla
			  de arriba y se queda quieto (solo aparece), mientras el cuerpo y el
			  ordinal entran desde la derecha. Con todo el `<li>` deslizándose, la
			  regla viajaba con él y quedaba corta por la izquierda durante la
			  entrada — una fila mal alineada en vez de una fila llegando.

			  El ordinal va un pelo atrás del cuerpo y desde menos distancia (ver
			  `.proceso-ordinal` en global.css): ese desfase es lo que le da
			  relieve a la fila en vez de que se mueva todo como una tabla.

			  Cero JS donde el navegador tiene `animation-timeline: view()`; en
			  Firefox lo cubre src/lib/revelar.ts con el GSAP que ya carga ahí.
			*/}
				<ol class="proceso-lista">
					{pasos.map((paso, i) => {
						return (
							<li class="border-banda-linea proceso-paso grid grid-cols-[2.6rem_minmax(0,1fr)] gap-5 border-t py-6 last:border-b">
								<span
									aria-hidden="true"
									class="text-accent proceso-ordinal font-serif text-xl tabular-nums"
								>
									{String(i + 1).padStart(2, "0")}
								</span>
								<div class="proceso-cuerpo min-w-0">
									<h3 class="text-banda-titulo text-lg font-semibold">{paso.titulo}</h3>
									<p class="mt-1.5 leading-relaxed">{paso.descripcion}</p>
								</div>
							</li>
						);
					})}
				</ol>
			</div>
		</section>
	)
}
