---
import { Button } from "@/components/ui/button";
import HeroInteracciones from "./HeroInteracciones.svelte";

interface Props {
	titulo: string;
	subtitulo: string;
	ctaTexto: string;
	ctaUrl: string;
	ctaSecundarioTexto: string;
	ctaSecundarioUrl: string;
}

const {
	titulo,
	subtitulo,
	ctaTexto,
	ctaUrl,
	ctaSecundarioTexto,
	ctaSecundarioUrl,
}: Props = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
	<div class="grid items-center gap-10 lg:grid-cols-2">
		<div>
			<h1
				data-hero="titulo"
				class="hero-animable hero-animable-titulo font-serif text-4xl font-bold tracking-tight text-balance sm:text-5xl"
			>
				{titulo}
			</h1>
			<p
				data-hero="subtitulo"
				class="hero-animable hero-animable-subtitulo text-muted-foreground mt-5 text-lg text-pretty"
			>
				{subtitulo}
			</p>
			<div
				data-hero="botones"
				class="hero-animable hero-animable-botones mt-8 flex flex-wrap gap-3"
			>
				<Button href={ctaUrl} size="lg" class="cta-backlight">{ctaTexto}</Button>
				<Button href={ctaSecundarioUrl} variant="outline" size="lg">
					{ctaSecundarioTexto}
				</Button>
			</div>
		</div>

		<div
			class="hero-animable-imagen bg-muted relative mx-auto aspect-[3/4] max-h-[32rem] w-full max-w-sm overflow-hidden rounded-2xl lg:max-w-none"
		>
			<div
				data-hero="imagen"
				class="absolute inset-0 h-full w-full scale-[1.08]"
			>
				<slot name="imagen" />
			</div>
		</div>
	</div>

	<HeroInteracciones client:load />
</section>
