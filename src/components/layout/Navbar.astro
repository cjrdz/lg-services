---
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n";
import { localizedUrl, stripLocale } from "@/i18n/routing";
import { SITIO, iniciales } from "@/lib/sitio";
import ThemeToggle from "@/components/ThemeToggle.astro";
import MobileMenu from "./MobileMenu.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Active route without the locale prefix, so highlighting works the same on
// /servicios/ as on /en/servicios/.
const actual = stripLocale(Astro.url.pathname);

/*
  `visible` isn't decorative: turning a section on without its page existing
  leaves the menu linking to a 404. Happened with /vehiculos/ (still phase 5
  at the time), and the server called it out:
    [router] A `getStaticPaths()` route pattern was matched, but no matching
    static path was found for requested path `/vehiculos/`.
  That's why `modulos.vehiculos` starts false until the section exists.
*/
const enlaces = [
	{ path: "/servicios", label: t("nav.servicios"), visible: true },
	{
		path: "/propiedades",
		label: t("nav.propiedades"),
		visible: SITIO.modulos.propiedades,
	},
	{ path: "/vehiculos", label: t("nav.vehiculos"), visible: SITIO.modulos.vehiculos },
	{ path: "/blog", label: t("nav.blog"), visible: SITIO.modulos.blog },
	{ path: "/contacto", label: t("nav.contacto"), visible: true },
]
	.filter((e) => e.visible)
	.map((e) => ({
		href: localizedUrl(e.path, locale),
		label: e.label,
		activo: actual === `${e.path}/` || actual.startsWith(`${e.path}/`),
	}));

/*
  On desktop /contacto is the solid button at the end of the row, so it would
  otherwise appear twice. The mobile drawer keeps the full list — there the
  button collapses into the menu.
*/
const navegables = enlaces.filter((e) => !e.href.endsWith("/contacto/"));
const contacto = localizedUrl("/contacto", locale);
---

{
	/*
	  `transition:animate="none"`: la cabecera NO se desvanece con la página.

	  Con <ClientRouter /> todo el documento entra en el fundido de
	  `::view-transition-*(root)`, cabecera incluida — así que en cada
	  navegación el encabezado parpadeaba junto con el contenido, que es
	  justo lo que hace que una navegación se sienta como una recarga. Con un
	  nombre propio sale del snapshot de la raíz y se dibuja directo en su
	  estado nuevo: el enlace activo cambia, pero la barra no se mueve.

	  "none" y no una animación: lo que tiene que hacer es quedarse quieta.
	*/
}
<header
	transition:animate="none"
	class="bg-background/85 border-border sticky top-0 z-50 border-b backdrop-blur-md"
>
	<div class="contenedor flex h-20 items-center gap-6">
		<a
			href={localizedUrl("/", locale)}
			class="group flex shrink-0 items-center gap-3.5"
			aria-label={SITIO.nombreLegal}
		>
			{
				/*
			  A bordered square, not a rounded pill and not a wordmark image:
			  the monogram is type, so it scales, prints and inverts with the
			  theme for free.
			*/
			}
			<span
				aria-hidden="true"
				class="border-primary text-primary group-hover:bg-primary group-hover:text-primary-foreground color-animado grid size-11 shrink-0 place-items-center border font-serif text-xl"
			>
				{iniciales()}
			</span>
			<span class="hidden flex-col leading-tight sm:flex">
				<span class="font-serif text-[1.15rem] tracking-tight">
					{SITIO.nombreLegal}
				</span>
				<span
					class="text-muted-foreground text-[0.68rem] font-semibold tracking-[0.13em] uppercase"
				>
					{SITIO.profesion}
				</span>
			</span>
		</a>

		{
			/*
		  `data-astro-prefetch="viewport"` solo acá: el menú está en pantalla
		  en todas las páginas y son las cinco direcciones a las que de verdad
		  va la gente, así que se bajan antes de que nadie haga clic. El resto
		  del sitio se queda en "hover" (ver astro.config.mjs) — en una grilla
		  de anuncios, "viewport" pediría una página por tarjeta visible.
		*/
		}
		<nav
			class="ml-auto hidden items-center gap-7 lg:flex"
			aria-label={t("nav.menuPrincipal")}
		>
			{
				navegables.map((enlace) => (
					<a
						href={enlace.href}
						aria-current={enlace.activo ? "page" : undefined}
						data-astro-prefetch="viewport"
						class="hover:text-primary aria-[current=page]:text-primary color-animado text-[0.95rem] font-medium"
					>
						{enlace.label}
					</a>
				))
			}
			<a
				href={contacto}
				data-astro-prefetch="viewport"
				class="bg-primary text-primary-foreground hover:bg-primary/90 color-animado rounded-lg px-5 py-3 text-[0.95rem] font-semibold"
			>
				{t("nav.agendar")}
			</a>
		</nav>

		<div class="ml-auto flex items-center gap-1 lg:ml-0">
			<ThemeToggle locale={locale} />
			<MobileMenu
				enlaces={enlaces}
				etiquetaAbrir={t("nav.abrirMenu")}
				etiquetaCerrar={t("nav.cerrarMenu")}
			/>
		</div>
	</div>
</header>
