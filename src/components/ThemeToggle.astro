---
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n";
import Icon from "@/components/Icon.astro";

/**
 * Cambio de tema. CERO JavaScript propio.
 *
 * Antes era una isla de Svelte con `morphicons`, y por estar en la cabecera
 * se cargaba en TODAS las páginas: el runtime de Svelte (18.6 KB gzip) más
 * morphicons (7.8 KB) para dibujar un sol y una luna. En una página del blog,
 * que no tiene ninguna otra isla, eso era el 100 % del JavaScript del sitio.
 *
 * Ahora son dos SVG resueltos en el build y un cruce en CSS
 * (`.tema-icono`, en global.css). El estado NO se lee ni se escribe acá: lo
 * dice `.dark` en <html>, así que el botón se dibuja bien en el primer paint
 * sin que nadie hidrate nada, y sobrevive a los cambios de página del
 * <ClientRouter /> sin volver a montarse.
 *
 * El clic lo atiende public/scripts/theme-init.js, que ya corría antes del
 * paint para evitar el destello de tema claro y escucha por delegación en
 * `document` — un listener para toda la vida del documento.
 *
 * Las dos etiquetas viajan como data-* porque el texto visible vive en
 * es.json y este script es `is:inline`: no pasa por el bundler y no puede
 * importar `t()`.
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button
	type="button"
	data-tema
	data-label-claro={t("nav.temaClaro")}
	data-label-oscuro={t("nav.temaOscuro")}
	aria-label={t("nav.cambiarTema")}
	aria-pressed="false"
	class="hover:bg-muted color-animado relative inline-flex size-9 items-center justify-center rounded-lg"
>
	<Icon name="lucide:sun" size={20} class="tema-icono tema-icono-sol" />
	<Icon name="lucide:moon" size={20} class="tema-icono tema-icono-luna" />
</button>
