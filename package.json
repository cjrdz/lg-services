{
	"name": "lg-services",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:clean": "rm -rf node_modules/.vite .astro && astro dev",
		"dev:stop": "astro dev stop",
		"dev:status": "astro dev status",
		"dev:logs": "astro dev logs",
		"build": "astro build",
		"preview": "wrangler dev -c dist/server/wrangler.json",
		"deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
		"deploy:check": "astro build && wrangler deploy --dry-run -c dist/server/wrangler.json",
		"cf-typegen": "wrangler types",
		"media:gc": "node scripts/media-gc.mjs",
		"check": "astro check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:colors": "node scripts/check-color-literals.mjs",
		"lint:links": "node scripts/check-links.mjs",
		"format": "prettier . --check",
		"format:write": "prettier . --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"smoke": "node scripts/smoke.mjs",
		"smoke:cache": "node scripts/smoke-cache.mjs",
		"browser:deps": "bash scripts/browser-deps.sh",
		"verify": "bun run lint:colors && bun run lint && bun run check && bun run test && bun run build && bun run lint:links",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.3.0",
		"@astrojs/mdx": "^8.0.0",
		"@astrojs/react": "^6.0.5",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "9.0.1",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.9",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.1",
		"clsx": "^2.1.1",
		"lucide": "^1.41.0",
		"morphicons": "^1.7.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"svelte": "^5.57.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@aws-sdk/client-s3": "^3.1127.0",
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.129",
		"@iconify/utils": "^3.1.7",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"eslint": "^10.10.0",
		"eslint-plugin-astro": "^3.1.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.69.0",
		"vitest": "^5.0.0",
		"wrangler": "^4.129.0"
	},
	"allowScripts": {
		"esbuild": true,
		"sharp": true,
		"@tailwindcss/oxide": true,
		"workerd": true
	}
}
